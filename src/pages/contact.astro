---
import LabLayout from '../layouts/LabLayout.astro';
---

<LabLayout title="Contact — Jungbluth Lab">
  <br />
  <h1 class="font-heading text-3xl font-bold text-gray-900 dark:text-slate-100">Contact</h1>
  <div class="mt-2 h-0.5 w-10 rounded-full bg-gradient-to-r from-lab-500 to-lab-600"></div>

  <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-3xl" data-animate="stagger">
    <div class="rounded-lg bg-michelle-50 dark:bg-michelle-900/20 border border-michelle-200 dark:border-michelle-800 p-6 hover:-translate-y-0.5 hover:shadow-lg transition-all duration-200">
      <h2 class="font-heading text-lg font-bold text-gray-900 dark:text-slate-100">Michelle Jungbluth</h2>
      <p class="mt-1 text-sm text-michelle-700 dark:text-michelle-400">Oceanographer, Zooplankton and Food Web Ecologist</p>
      <div class="mt-4 space-y-2 text-sm text-gray-700 dark:text-slate-400">
        <p class="text-xs font-medium text-gray-500 dark:text-slate-500 uppercase tracking-wider">General Inquiries</p>
        <p>michelle dot marinelab at gmail dot com</p>
        <p class="text-xs font-medium text-gray-500 dark:text-slate-500 uppercase tracking-wider mt-2">SFSU-specific Inquiries</p>
        <p>mjungbluth at sfsu dot edu</p>
      </div>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="https://scholar.google.com/citations?user=sGNBJUIAAAAJ&hl=en" target="_blank" rel="noopener noreferrer" class="text-xs text-michelle-600 dark:text-michelle-400 hover:text-michelle-700 dark:hover:text-michelle-300 hover:underline font-medium">Google Scholar</a>
        <a href="https://www.linkedin.com/in/michelle-jungbluth/" target="_blank" rel="noopener noreferrer" class="text-xs text-michelle-600 dark:text-michelle-400 hover:text-michelle-700 dark:hover:text-michelle-300 hover:underline font-medium">LinkedIn</a>
        <a href="https://www.researchgate.net/profile/Michelle_Jungbluth" target="_blank" rel="noopener noreferrer" class="text-xs text-michelle-600 dark:text-michelle-400 hover:text-michelle-700 dark:hover:text-michelle-300 hover:underline font-medium">ResearchGate</a>
        <a href="https://orcid.org/0000-0001-9339-7497" target="_blank" rel="noopener noreferrer" class="text-xs text-michelle-600 dark:text-michelle-400 hover:text-michelle-700 dark:hover:text-michelle-300 hover:underline font-medium">ORCID</a>
      </div>
    </div>

    <div class="rounded-lg bg-sean-50 dark:bg-sean-900/20 border border-sean-200 dark:border-sean-800 p-6 hover:-translate-y-0.5 hover:shadow-lg transition-all duration-200">
      <h2 class="font-heading text-lg font-bold text-gray-900 dark:text-slate-100">Sean Jungbluth</h2>
      <p class="mt-1 text-sm text-sean-700 dark:text-sean-400">Oceanographer, Microbial Ecologist, and Computational Biologist</p>
      <div class="mt-4 space-y-2 text-sm text-gray-700 dark:text-slate-400">
        <p class="text-xs font-medium text-gray-500 dark:text-slate-500 uppercase tracking-wider">General Inquiries</p>
        <p>seanj dot lab at gmail dot com</p>
        <p class="text-xs font-medium text-gray-500 dark:text-slate-500 uppercase tracking-wider mt-2">SFSU-specific Inquiries</p>
        <p>sjungbluth at sfsu dot edu</p>
      </div>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="https://seanj.me" target="_blank" rel="noopener noreferrer" class="text-xs text-sean-600 dark:text-sean-400 hover:text-sean-700 dark:hover:text-sean-300 hover:underline font-medium">Personal</a>
        <a href="https://github.com/jungbluth" target="_blank" rel="noopener noreferrer" class="text-xs text-sean-600 dark:text-sean-400 hover:text-sean-700 dark:hover:text-sean-300 hover:underline font-medium">GitHub</a>
        <a href="https://scholar.google.com/citations?user=WANnSuYAAAAJ&hl=en" target="_blank" rel="noopener noreferrer" class="text-xs text-sean-600 dark:text-sean-400 hover:text-sean-700 dark:hover:text-sean-300 hover:underline font-medium">Google Scholar</a>
        <a href="https://orcid.org/0000-0001-9265-8341" target="_blank" rel="noopener noreferrer" class="text-xs text-sean-600 dark:text-sean-400 hover:text-sean-700 dark:hover:text-sean-300 hover:underline font-medium">ORCID</a>
        <a href="https://www.linkedin.com/in/sean-jungbluth-2230b314" target="_blank" rel="noopener noreferrer" class="text-xs text-sean-600 dark:text-sean-400 hover:text-sean-700 dark:hover:text-sean-300 hover:underline font-medium">LinkedIn</a>
      </div>
    </div>
  </div>
</LabLayout>
