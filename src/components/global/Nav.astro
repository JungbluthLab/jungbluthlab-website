---
import { Image } from 'astro:assets';
import logoImg from '../../assets/images/logos/jungbluth-lab-logo-alt.png';

const currentPath = Astro.url.pathname;

const navItems = [
  { label: 'Home', href: '/' },
  {
    label: 'Lab',
    href: '/lab',
    children: [
      { label: 'Overview', href: '/lab' },
      { label: 'People', href: '/lab/people' },
      { label: 'Research', href: '/lab/research' },
      { label: 'News', href: '/lab/news' },
    ],
  },
  {
    label: 'Michelle',
    href: '/michelle',
    children: [
      { label: 'About', href: '/michelle' },
      { label: 'Research', href: '/michelle/research' },
      { label: 'Teaching & Outreach', href: '/michelle/teaching' },
    ],
  },
  {
    label: 'Sean',
    href: '/sean',
    children: [
      { label: 'About', href: '/sean' },
      { label: 'Research', href: '/sean/research' },
      { label: 'Teaching & Outreach', href: '/sean/teaching' },
    ],
  },
{ label: 'Join', href: '/join' },
  { label: 'Contact', href: '/contact' },
];

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<nav class="bg-white/80 dark:bg-slate-900/80 backdrop-blur-md border-b border-gray-200/50 dark:border-slate-700/50 sticky top-0 z-50 transition-all duration-300">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <a href="/" class="flex items-center gap-2 font-heading text-xl font-bold text-gray-900 dark:text-slate-100 tracking-tight">
        <Image src={logoImg} alt="Jungbluth Lab logo" width={40} height={40} class="w-10 h-10" transition:name="nav-logo" />
        Jungbluth Lab
      </a>

      <!-- Desktop nav -->
      <div class="hidden md:flex md:items-center md:gap-1">
        {navItems.map((item) => (
          <div class="relative group">
            <a
              href={item.href}
              class:list={[
                'px-3 py-2 text-sm font-medium rounded-md transition-colors',
                isActive(item.href)
                  ? 'text-lab-700 dark:text-lab-400 bg-lab-50 dark:bg-lab-900/20'
                  : 'text-gray-600 dark:text-slate-400 hover:text-gray-900 dark:hover:text-slate-100 hover:bg-gray-50 dark:hover:bg-slate-800',
              ]}
            >
              {item.label}
            </a>
            {item.children && (
              <div class="absolute left-0 top-full pt-1 hidden group-hover:block z-50">
                <div class="rounded-lg bg-white dark:bg-slate-800 shadow-lg ring-1 ring-gray-200 dark:ring-slate-700 py-2 min-w-[180px]">
                  {item.children.map((child) => (
                    <a
                      href={child.href}
                      class:list={[
                        'block px-4 py-2 text-sm transition-colors',
                        isActive(child.href)
                          ? 'text-lab-700 dark:text-lab-400 bg-lab-50 dark:bg-lab-900/20'
                          : 'text-gray-600 dark:text-slate-400 hover:text-gray-900 dark:hover:text-slate-100 hover:bg-gray-50 dark:hover:bg-slate-700',
                      ]}
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        ))}
      </div>

      <!-- Mobile hamburger -->
      <button
        id="mobile-menu-btn"
        class="md:hidden p-2 rounded-md text-gray-600 dark:text-slate-400 hover:text-gray-900 dark:hover:text-slate-100 hover:bg-gray-100 dark:hover:bg-slate-800"
        aria-label="Open menu"
      >
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-gray-200 dark:border-slate-700 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md">
    <div class="px-4 py-3 space-y-1">
      {navItems.map((item) => (
        <>
          <a
            href={item.href}
            class:list={[
              'block px-3 py-2 text-base font-medium rounded-md',
              isActive(item.href)
                ? 'text-lab-700 dark:text-lab-400 bg-lab-50 dark:bg-lab-900/20'
                : 'text-gray-600 dark:text-slate-400 hover:text-gray-900 dark:hover:text-slate-100 hover:bg-gray-50 dark:hover:bg-slate-800',
            ]}
          >
            {item.label}
          </a>
          {item.children && (
            <div class="pl-4 space-y-1">
              {item.children.map((child) => (
                <a
                  href={child.href}
                  class:list={[
                    'block px-3 py-1.5 text-sm rounded-md',
                    isActive(child.href)
                      ? 'text-lab-700 dark:text-lab-400 bg-lab-50 dark:bg-lab-900/20'
                      : 'text-gray-500 dark:text-slate-500 hover:text-gray-900 dark:hover:text-slate-100 hover:bg-gray-50 dark:hover:bg-slate-800',
                  ]}
                >
                  {child.label}
                </a>
              ))}
            </div>
          )}
        </>
      ))}
    </div>
  </div>
</nav>

<script>
  function initNav() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const nav = document.querySelector('nav');

    btn?.addEventListener('click', () => {
      menu?.classList.toggle('hidden');
    });

    if (nav) {
      const onScroll = () => {
        const isDark = document.documentElement.classList.contains('dark');
        if (window.scrollY > 10) {
          nav.classList.add('shadow-sm');
          if (isDark) {
            nav.classList.add('bg-slate-900/95');
            nav.classList.remove('bg-slate-900/80');
          } else {
            nav.classList.add('bg-white/95');
            nav.classList.remove('bg-white/80');
          }
        } else {
          nav.classList.remove('shadow-sm', 'bg-white/95', 'bg-slate-900/95');
          if (isDark) {
            nav.classList.add('bg-slate-900/80');
          } else {
            nav.classList.add('bg-white/80');
          }
        }
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('theme-change', onScroll);
      onScroll();
    }
  }

  initNav();
  document.addEventListener('astro:after-swap', initNav);
</script>
