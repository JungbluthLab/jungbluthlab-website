---
import WaveDivider from '../decorative/WaveDivider.astro';
import ThemeToggle from './ThemeToggle.astro';

const year = new Date().getFullYear();
---

<WaveDivider color="lab" flip />
<footer class="bg-gray-50 dark:bg-slate-800">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div>
        <h3 class="font-heading text-lg font-semibold text-gray-900 dark:text-slate-100">Jungbluth Lab</h3>
        <p class="mt-2 text-sm text-gray-600 dark:text-slate-400">
          Oceanography, ecology, and computational biology research by Michelle and Sean Jungbluth.
        </p>
      </div>
      <div>
        <h4 class="font-heading text-sm font-semibold text-gray-900 dark:text-slate-100 uppercase tracking-wider">Quick Links</h4>
        <ul class="mt-2 space-y-1">
          <li><a href="/michelle" class="text-sm text-gray-600 dark:text-slate-400 hover:text-michelle-600 dark:hover:text-michelle-400 transition-colors">Michelle</a></li>
          <li><a href="/sean" class="text-sm text-gray-600 dark:text-slate-400 hover:text-sean-600 dark:hover:text-sean-400 transition-colors">Sean</a></li>
          <li><a href="/lab/people" class="text-sm text-gray-600 dark:text-slate-400 hover:text-lab-600 dark:hover:text-lab-400 transition-colors">People</a></li>
          <li><a href="/join" class="text-sm text-gray-600 dark:text-slate-400 hover:text-lab-600 dark:hover:text-lab-400 transition-colors">Join the Lab</a></li>
        </ul>
      </div>
      <div>
        <h4 class="font-heading text-sm font-semibold text-gray-900 dark:text-slate-100 uppercase tracking-wider">Contact</h4>
        <ul class="mt-2 space-y-1">
          <li class="text-sm text-gray-600 dark:text-slate-400">michelle dot marinelab at gmail dot com</li>
          <li class="text-sm text-gray-600 dark:text-slate-400">seanj dot lab at gmail dot com</li>
        </ul>
      </div>
    </div>
    <div class="mt-8 pt-6 border-t border-gray-200 dark:border-slate-700 flex items-center justify-between">
      <p class="text-xs text-gray-500 dark:text-slate-500">&copy; 2017&ndash;{year} Jungbluth Lab</p>
      <ThemeToggle />
    </div>
  </div>
</footer>
