---
---

<div class="flex items-center gap-2">
  <button
    id="theme-toggle"
    role="switch"
    aria-checked="false"
    aria-label="Toggle dark mode"
    class="inline-flex items-center rounded-full bg-gray-200 dark:bg-slate-700 p-1 gap-0.5 cursor-pointer transition-colors"
  >
    <span
      id="theme-light-pill"
      class="flex items-center gap-1 rounded-full px-2.5 py-1 text-xs font-medium transition-all"
    >
      <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" clip-rule="evenodd" />
      </svg>
      Light
    </span>
    <span
      id="theme-dark-pill"
      class="flex items-center gap-1 rounded-full px-2.5 py-1 text-xs font-medium transition-all"
    >
      <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
        <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z" />
      </svg>
      Dark
    </span>
  </button>
</div>

<script>
  function initThemeToggle() {
    const toggle = document.getElementById('theme-toggle');
    const lightPill = document.getElementById('theme-light-pill');
    const darkPill = document.getElementById('theme-dark-pill');
    if (!toggle || !lightPill || !darkPill) return;

    const update = () => {
      const isDark = document.documentElement.classList.contains('dark');
      toggle.setAttribute('aria-checked', String(isDark));

      if (isDark) {
        lightPill.className = 'flex items-center gap-1 rounded-full px-2.5 py-1 text-xs font-medium transition-all bg-transparent text-slate-500 shadow-none';
        darkPill.className = 'flex items-center gap-1 rounded-full px-2.5 py-1 text-xs font-medium transition-all bg-indigo-600 text-white shadow-sm';
      } else {
        lightPill.className = 'flex items-center gap-1 rounded-full px-2.5 py-1 text-xs font-medium transition-all bg-white text-gray-700 shadow-sm';
        darkPill.className = 'flex items-center gap-1 rounded-full px-2.5 py-1 text-xs font-medium transition-all bg-transparent text-gray-400 shadow-none';
      }
    };

    toggle.addEventListener('click', () => {
      const isDark = document.documentElement.classList.contains('dark');
      if (isDark) {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        localStorage.setItem('theme', 'dark');
      }
      update();
      window.dispatchEvent(new CustomEvent('theme-change'));
    });

    update();
  }

  initThemeToggle();
  document.addEventListener('astro:after-swap', initThemeToggle);
</script>
