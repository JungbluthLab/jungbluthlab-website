---
// No props needed — standalone section component
---

<link
  href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap"
  rel="stylesheet"
/>

<section id="explore-game" class="py-12 bg-gray-900">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <h2
      class="text-xl md:text-2xl font-bold text-white text-center"
      style="font-family: 'Press Start 2P', monospace;"
    >
      Explore the EOS Center
    </h2>
    <p class="mt-2 text-gray-400 text-center text-sm">
      Walk around our historic 53-acre campus
    </p>
    <p class="mt-1 text-gray-500 text-center text-xs">
      WASD to move &middot; SPACE to interact
    </p>

    <!-- Era Toggle -->
    <div class="flex justify-center gap-2 mt-6 mb-4">
      <button
        data-era="codfish"
        class="era-btn px-3 py-1.5 rounded-full border border-gray-600 text-gray-400 hover:border-lab-400 hover:text-lab-300 transition-colors"
        style="font-family: 'Press Start 2P', monospace; font-size: 9px;"
      >
        1880s Codfish
      </button>
      <button
        data-era="navy"
        class="era-btn px-3 py-1.5 rounded-full border border-gray-600 text-gray-400 hover:border-lab-400 hover:text-lab-300 transition-colors"
        style="font-family: 'Press Start 2P', monospace; font-size: 9px;"
      >
        1940s Navy
      </button>
      <button
        data-era="modern"
        class="era-btn px-3 py-1.5 rounded-full border border-gray-600 text-gray-400 hover:border-lab-400 hover:text-lab-300 transition-colors"
        style="font-family: 'Press Start 2P', monospace; font-size: 9px;"
      >
        Today
      </button>
    </div>

    <!-- Tour Button -->
    <div class="flex justify-center mt-2 mb-2">
      <button
        id="tour-btn"
        class="px-3 py-1.5 rounded-full border border-gray-600 text-gray-400 hover:border-lab-400 hover:text-lab-300 transition-colors"
        style="font-family: 'Press Start 2P', monospace; font-size: 8px;"
      >
        Guided Tour
      </button>
    </div>

    <!-- Canvas Container -->
    <div class="relative mx-auto" style="max-width: 1200px;">
      <!-- Start Overlay -->
      <div
        id="game-start-overlay"
        class="absolute inset-0 z-20 flex flex-col items-center justify-center bg-black/70 rounded-lg cursor-pointer"
      >
        <p
          class="text-white"
          style="font-family: 'Press Start 2P', monospace; font-size: 14px;"
        >
          Click to Explore
        </p>
        <p class="text-gray-400 mt-4 text-sm">WASD / Arrow keys to walk</p>
      </div>

      <!-- Tutorial Overlay -->
      <div
        id="game-tutorial"
        class="absolute inset-0 z-30 flex items-center justify-center bg-black/80 rounded-lg"
        style="display: none;"
      >
        <div class="text-center">
          <p
            id="tutorial-step-text"
            class="text-white mb-4"
            style="font-family: 'Press Start 2P', monospace; font-size: 11px; line-height: 2;"
          ></p>
          <p class="text-gray-400 text-xs">Click or press any key to continue</p>
          <div id="tutorial-dots" class="flex justify-center gap-2 mt-4"></div>
        </div>
      </div>

      <!-- Era Completion Celebration -->
      <div
        id="era-complete"
        class="absolute inset-0 z-30 flex items-center justify-center rounded-lg cursor-pointer"
        style="display: none;"
      >
        <div class="text-center animate-bounce">
          <p
            class="text-yellow-400"
            style="font-family: 'Press Start 2P', monospace; font-size: 16px; text-shadow: 2px 2px 4px rgba(0,0,0,0.8);"
          >
            ERA COMPLETE!
          </p>
          <p
            id="era-complete-text"
            class="text-white mt-3"
            style="font-family: 'Press Start 2P', monospace; font-size: 9px; text-shadow: 1px 1px 2px rgba(0,0,0,0.8);"
          ></p>
        </div>
      </div>

      <canvas
        id="game-canvas"
        width="384"
        height="256"
        role="application"
        aria-label="Interactive 8-bit exploration game of the EOS Center campus. Use WASD or arrow keys to walk, SPACE to interact with buildings."
        class="w-full rounded-lg border-2 border-lab-600"
        style="aspect-ratio: 3/2; image-rendering: pixelated; image-rendering: crisp-edges;"
      ></canvas>

      <!-- Popup Overlay -->
      <div id="game-popup" class="absolute inset-0 z-10 items-center justify-center" style="display: none;">
        <div class="absolute inset-0 bg-black/50 rounded-lg" id="popup-backdrop"></div>
        <div
          class="relative bg-gray-900 border-2 border-lab-500 rounded-lg p-6 max-w-md mx-4 z-10"
        >
          <button
            id="popup-close"
            class="absolute top-2 right-3 text-gray-400 hover:text-white text-xl leading-none"
          >
            &times;
          </button>
          <h3
            id="popup-title"
            class="text-lab-300 font-bold pr-6"
            style="font-family: 'Press Start 2P', monospace; font-size: 11px; line-height: 1.6;"
          ></h3>
          <p id="popup-era-info" class="text-gray-500 text-xs mt-1"></p>
          <p id="popup-desc" class="text-gray-300 text-sm mt-3 leading-relaxed"></p>
          <div class="mt-4 bg-lab-900/50 border border-lab-700 rounded p-3">
            <p
              class="text-lab-400 font-bold"
              style="font-family: 'Press Start 2P', monospace; font-size: 8px;"
            >
              Did you know?
            </p>
            <p id="popup-fact-text" class="text-gray-300 text-xs mt-1 leading-relaxed"></p>
          </div>
        </div>
      </div>
    </div>

    <!-- Mobile Controls -->
    <div id="mobile-controls" class="hidden mt-4 flex justify-between items-center px-8">
      <div class="relative w-24 h-24">
        <button
          data-dir="up"
          class="mobile-btn absolute top-0 left-1/2 -translate-x-1/2 w-8 h-8 bg-gray-700 rounded text-white text-sm active:bg-gray-500"
        >&#9650;</button>
        <button
          data-dir="left"
          class="mobile-btn absolute top-1/2 left-0 -translate-y-1/2 w-8 h-8 bg-gray-700 rounded text-white text-sm active:bg-gray-500"
        >&#9664;</button>
        <button
          data-dir="right"
          class="mobile-btn absolute top-1/2 right-0 -translate-y-1/2 w-8 h-8 bg-gray-700 rounded text-white text-sm active:bg-gray-500"
        >&#9654;</button>
        <button
          data-dir="down"
          class="mobile-btn absolute bottom-0 left-1/2 -translate-x-1/2 w-8 h-8 bg-gray-700 rounded text-white text-sm active:bg-gray-500"
        >&#9660;</button>
      </div>
      <button
        id="mobile-action"
        class="w-16 h-16 bg-lab-600 rounded-full text-white active:bg-lab-700"
        style="font-family: 'Press Start 2P', monospace; font-size: 8px;"
      >
        ACT
      </button>
    </div>

    <!-- Discovery Counter -->
    <div class="text-center mt-3">
      <span
        class="text-gray-500"
        style="font-family: 'Press Start 2P', monospace; font-size: 9px;"
      >
        <span id="discovery-count">0</span>/<span id="discovery-total">0</span> discovered
      </span>
    </div>

    <!-- Collectible notification -->
    <div
      id="collectible-toast"
      class="fixed bottom-8 left-1/2 -translate-x-1/2 z-50 bg-gray-900 border-2 border-yellow-400 rounded-lg px-4 py-2 transition-all duration-300 opacity-0 pointer-events-none"
      style="font-family: 'Press Start 2P', monospace; font-size: 9px;"
    >
      <span class="text-yellow-400">Found: </span>
      <span id="collectible-toast-text" class="text-white"></span>
    </div>

    <!-- Collectible counter -->
    <div class="text-center mt-1">
      <span
        class="text-yellow-500/70"
        style="font-family: 'Press Start 2P', monospace; font-size: 8px;"
      >
        <span id="collectible-count">0</span>/<span id="collectible-total">0</span> items found
      </span>
    </div>
  </div>
</section>

<script>
  import { initGame } from '../../lib/game/engine';

  const section = document.getElementById('explore-game');
  if (section) {
    let initialized = false;
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries[0].isIntersecting && !initialized) {
          initialized = true;
          initGame();

          // Show mobile controls only on touch devices
          if ('ontouchstart' in window || navigator.maxTouchPoints > 0) {
            const mc = document.getElementById('mobile-controls');
            if (mc) mc.classList.remove('hidden');
          }

          observer.disconnect();
        }
      },
      { threshold: 0.1 },
    );
    observer.observe(section);
  }
</script>
